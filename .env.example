# Template env FRONTEND. Salin jadi .env.local untuk `npm run dev` di laptop.
# Semua file .env* di-gitignore & di-dockerignore — jangan pernah di-commit.
# Repo ini FE saja: database, JWT, SMTP, Mekari, dll. ada di repo jm-travel-api (backend).

# --- Backend (jm-travel-api) — hanya untuk `next dev` di laptop ---
# Jalankan backend lokal (`npm run dev` / `npm run dev:dev` di repo jm-travel-api, port 3001).
# Di dev/prod JANGAN di-set: Caddy yang mengirim /api/* ke backend.
API_URL=http://localhost:3001

# Cookie Secure (dibaca src/proxy.js saat membersihkan cookie sesi kedaluwarsa).
# Di localhost (http) set false. HARUS sama dengan COOKIE_SECURE backend.
COOKIE_SECURE=false

# --- reCAPTCHA site key / analytics (opsional, diinline saat build) ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_SNAPWIDGET_ID=
