# Template env. Salin jadi salah satu dari:
#   .env.local -> testing lokal  (npm run dev)
#   .env.dev   -> data server dev   (npm run dev:dev)
#   .env.prod  -> data server prod  (npm run dev:prod)  ⚠️ hati-hati
# Semua file .env* di-gitignore & di-dockerignore — jangan pernah di-commit.

# --- Database (MariaDB/MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jm_travel

# --- Auth --- (dev/prod: HARUS sama dengan JWT_SECRET service api di server tsb)
JWT_SECRET=ganti-dengan-string-acak
# Cookie Secure. Di localhost (http) set false supaya login jalan.
COOKIE_SECURE=false

# --- URL publik (link di ID card, dll.) ---
APP_URL=http://localhost:3000

# --- reCAPTCHA / analytics (opsional) ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_SNAPWIDGET_ID=

# --- TTD digital + e-Meterai (Mekari Sign) — biarkan mock untuk testing ---
TTD_PROVIDER=mock
MATERAI_PROVIDER=mock
MEKARI_API_BASE_URL=
MEKARI_BEARER_TOKEN=
MEKARI_WEBHOOK_SECRET=
